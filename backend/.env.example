# Copy to .env and fill in. Never commit .env.

# local | test | staging | production
ENVIRONMENT=local
LOG_LEVEL=INFO
# Comma-separated dashboard origins
CORS_ORIGINS=http://localhost:5173

# Runtime: the NON-owner role (app_user) through Neon's pooler, so RLS always applies.
# The app refuses to start if this role can bypass row-level security.
DATABASE_URL=postgresql://app_user:PASSWORD@ep-xxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require
# Migrations: the owner role, direct (non-pooled) host.
MIGRATIONS_DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require

# Test database: wiped on every test run. Never point at real data.
TEST_DATABASE_URL=postgresql://app_user:PASSWORD@ep-xxx-pooler.eu-west-2.aws.neon.tech/neondb_test?sslmode=require
TEST_MIGRATIONS_DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxx.eu-west-2.aws.neon.tech/neondb_test?sslmode=require

# Signs session tokens (generate 48+ random bytes). Rotating it logs everyone out.
SECRET_KEY=

# Optional: Sentry error monitoring (free developer plan)
# SENTRY_DSN=
